{
  "name": "linkedin-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.toml",
    "webhook:dev": "bash tools/dev-webhook.sh",
    "deploy": "bash tools/pre-deploy-check.sh && wrangler deploy --config wrangler.prod.toml",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "lint:ci": "biome ci src/",
    "docs": "node tools/require-jsdoc.mjs",
    "check": "pnpm lint && pnpm run docs && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:migration": "vitest run --config vitest.migration.config.ts",
    "test:provider-contract": "DEEPSEEK_CONTRACT=1 vitest run src/__contract__/deepseek-calendar.contract.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@cloudflare/workers-types": "^5.20250710.1",
    "@types/node": "^24.0.0",
    "lefthook": "^2.1.10",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "wrangler": "^4.10.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "rrule": "^2.8.1",
    "zod": "^3.24.2"
  },
  "packageManager": "pnpm@9.15.4"
}
