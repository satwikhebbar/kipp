{
  "provenance": "Synthetic examples authored 2026-11-10 from Buffer public schemas. Not captured API responses. No credentials or real account/channel/post IDs.",
  "requiredScopes": ["account:read", "posts:read", "posts:write", "offline_access"],
  "oauthTokenResponse": {
    "access_token": "SYNTHETIC_ACCESS_TOKEN",
    "refresh_token": "SYNTHETIC_SINGLE_USE_REFRESH_TOKEN",
    "token_type": "Bearer",
    "expires_in": 3600,
    "scope": "account:read posts:read posts:write offline_access"
  },
  "channel": {
    "id": "000000000000000000000001",
    "organizationId": "000000000000000000000002",
    "service": "substack",
    "allowedActions": ["scheduleUpdates", "readUpdates"],
    "isDisconnected": false,
    "isLocked": false,
    "isQueuePaused": false
