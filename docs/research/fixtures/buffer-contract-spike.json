  "requests": {
    "immediate": {
      "channelId": "000000000000000000000001",
      "text": "A synthetic Note for contract tests; never send this fixture to a real account.",
      "assets": [],
      "mode": "shareNow",
      "schedulingType": "automatic",
      "needsApproval": false,
      "saveToDraft": false
