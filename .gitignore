node_modules/
dist/
.wrangler/
.env
.dev.vars
logs/
*.log
.DS_Store

# Development scripts (local utility, not part of the deployable project)
scripts/

# Opencode tooling artifacts (project-level config lives elsewhere)
.opencode/

# Env-specific Wrangler config (contain real credentials/hashes/URNs)
wrangler.local.toml
wrangler.prod.toml

# Local agent handoff queues
.agent-handoff/inbox/*
.agent-handoff/in-progress/*
.agent-handoff/done/*
.agent-handoff/archive/*
!.agent-handoff/inbox/.gitkeep
!.agent-handoff/in-progress/.gitkeep
!.agent-handoff/done/.gitkeep
!.agent-handoff/archive/.gitkeep

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
